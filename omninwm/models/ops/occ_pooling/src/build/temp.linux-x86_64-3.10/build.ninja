ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-12.1/bin/nvcc

cflags = -pthread -B /home/qjyuan/miniconda3/envs/omni/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/qjyuan/miniconda3/envs/omni/include -fPIC -O2 -isystem /home/qjyuan/miniconda3/envs/omni/include -fPIC -I/home/qjyuan/miniconda3/envs/omni/lib/python3.10/site-packages/torch/include -I/home/qjyuan/miniconda3/envs/omni/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/qjyuan/miniconda3/envs/omni/lib/python3.10/site-packages/torch/include/TH -I/home/qjyuan/miniconda3/envs/omni/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-12.1/include -I/home/qjyuan/miniconda3/envs/omni/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=occ_pool_ext -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/qjyuan/miniconda3/envs/omni/lib/python3.10/site-packages/torch/include -I/home/qjyuan/miniconda3/envs/omni/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/qjyuan/miniconda3/envs/omni/lib/python3.10/site-packages/torch/include/TH -I/home/qjyuan/miniconda3/envs/omni/lib/python3.10/site-packages/torch/include/THC -I/usr/local/cuda-12.1/include -I/home/qjyuan/miniconda3/envs/omni/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=occ_pool_ext -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /data1/qjyuan/OmniNWM/omninwm/models/ops/occ_pooling/src/build/temp.linux-x86_64-3.10/occ_pool.o: compile /data1/qjyuan/OmniNWM/omninwm/models/ops/occ_pooling/src/occ_pool.cpp
build /data1/qjyuan/OmniNWM/omninwm/models/ops/occ_pooling/src/build/temp.linux-x86_64-3.10/occ_pool_cuda.o: cuda_compile /data1/qjyuan/OmniNWM/omninwm/models/ops/occ_pooling/src/occ_pool_cuda.cu






